31:["$","section",null,{"aria-labelledby":"faq-heading","className":"page-container pt-[22px] nav:pt-14 nav:pb-2","children":["$","div",null,{"className":"grid grid-cols-[repeat(auto-fit,minmax(min(320px,100%),1fr))] items-start gap-6 nav:gap-[34px]","children":[["$","div",null,{"children":[["$","div",null,{"className":"","children":[["$","span",null,{"className":"eyebrow text-[11px] tracking-[1.3px] nav:text-xs nav:tracking-[1.4px]","children":"Common questions"}],["$","h2",null,{"id":"faq-heading","className":"mt-[7px] font-display leading-[1.15] font-bold tracking-[-0.3px] text-ink-900 nav:mt-2 nav:tracking-[-0.5px] text-[23px] nav:text-[34px]","children":"Before you come in"}]]}],["$","p",null,{"className":"mt-3.5 mb-5 text-[15px] leading-[1.65] text-ink-700 nav:text-base","children":"The things our admitting desk gets asked most. If yours isn't here, call the trunkline or send us a message."}],["$","div",null,{"className":"flex flex-wrap gap-2.5","children":[["$","$Lb",null,{"href":"/contact","className":"flex items-center gap-2 rounded-button bg-navy-700 px-[19px] py-[13px] text-[14.5px] font-bold text-white hover:bg-navy-900 hover:text-white","children":[["$","span",null,{"className":"ms ","style":{"fontSize":19,"width":19,"height":19,"overflow":"hidden"},"aria-hidden":true,"role":"$undefined","aria-label":"$undefined","children":"mail"}],"Ask a question"]}],["$","a",null,{"href":"tel:+63324841200","className":"flex items-center gap-2 rounded-button border border-line-300 px-[19px] py-[13px] text-[14.5px] font-bold text-ink-900 hover:border-navy-700 hover:text-navy-700","children":[["$","span",null,{"className":"ms ","style":{"fontSize":19,"width":19,"height":19,"overflow":"hidden"},"aria-hidden":true,"role":"$undefined","aria-label":"$undefined","children":"call"}],"(032) 484 1200"]}]]}]]}],["$","$L38",null,{"faqs":[{"question":"Do I need an appointment, or can I walk in?","answer":"The emergency room and the laboratory accept walk-ins around the clock. Outpatient clinics also accept walk-ins, but consultants see booked patients first — requesting a slot ahead through our Contact page means you will not wait behind the morning queue."},{"question":"What should I bring on the day of my visit?","answer":"A valid ID for the patient and companion, your PhilHealth MDR or member ID, any HMO letter of authorization, your senior citizen or PWD booklet if applicable, and previous lab or imaging results."},{"question":"Is PhilHealth applied automatically?","answer":"Yes. Present your MDR or member ID at the admitting desk and the deduction is applied to your bill before you pay. Ward admissions under the case-rate packages carry no balance billing. The billing section will walk through each line with you."},{"question":"How long do laboratory and imaging results take?","answer":"Routine blood chemistry and urinalysis are released the same day. X-ray and ultrasound reports are ready within 24 hours, and CT studies done before 2 PM are read the same day. Emergency studies are read on call."},{"question":"Can someone stay with the patient overnight?","answer":"One watcher is allowed per patient at all times. General ward visiting hours are 10 AM to 8 PM, maternity 1 to 7 PM, and ICU 4 to 6 PM. Children under seven are not permitted in patient rooms."},{"question":"Do you have an ambulance for barangay transfers?","answer":"Yes. Call (032) 484 1234 and the ER will dispatch. We serve Sibonga and the neighbouring towns, and we coordinate transfers to tertiary hospitals in Cebu City when a case needs a higher level of care."}]}]]}]}]
