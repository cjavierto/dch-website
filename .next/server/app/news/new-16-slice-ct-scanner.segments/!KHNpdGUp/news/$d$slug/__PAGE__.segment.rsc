23:["$","ul","5",{"className":"mb-[18px] flex list-disc flex-col gap-2.5 pl-[22px] text-[15.5px] leading-[1.7] text-ink-700 nav:text-base","children":[["$","li","A physician's request is required for all CT studies, including those ordered from the ER.",{"children":"A physician's request is required for all CT studies, including those ordered from the ER."}],["$","li","Fasting of six hours is needed for abdominal studies with contrast.",{"children":"Fasting of six hours is needed for abdominal studies with contrast."}],["$","li","Bring previous X-ray, ultrasound, or CT results if you have them.",{"children":"Bring previous X-ray, ultrasound, or CT results if you have them."}],["$","li","PhilHealth and accredited HMO coverage may be applied at the billing window before the scan.",{"children":"PhilHealth and accredited HMO coverage may be applied at the billing window before the scan."}]]}]
