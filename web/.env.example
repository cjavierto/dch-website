# SQLite database file, relative to the app folder. Keep it outside public_html.
DATABASE_URL=file:./data/dch.db
# Long random string (openssl rand -hex 32). Signs admin sessions.
PAYLOAD_SECRET=
# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# First admin user, created by `npm run seed` if no users exist.
SEED_ADMIN_EMAIL=admin@dch.localhost
SEED_ADMIN_PASSWORD=
# Online appointment booking (/book). Leave unset/false for launch. Read at
# build time — set it where you run `npm run build`.
NEXT_PUBLIC_BOOKING_ENABLED=false
